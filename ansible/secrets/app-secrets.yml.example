# ---------------------------------------------------------------------------
# Sensitive values for the application, database and ArgoCD (issue #31).
#
# This is a TEMPLATE. Do NOT commit it with real values. Instead:
#
#   1. Rotate the credentials (the old ones are exposed in git history):
#
#        # Fresh Laravel APP_KEY (32 random bytes, base64):
#        echo "base64:$(openssl rand -base64 32)"
#
#        # Strong DB user password and Postgres superuser password:
#        openssl rand -base64 24
#        openssl rand -base64 24
#
#   2. Copy this file to `app-secrets.yml`, paste the rotated values, then
#      encrypt it IN PLACE with the SAME vault password used for secrets/id_rsa:
#
#        cp app-secrets.yml.example app-secrets.yml
#        # edit app-secrets.yml ...
#        ansible-vault encrypt app-secrets.yml
#
#   3. Commit the ENCRYPTED app-secrets.yml (like secrets/id_rsa). The playbook
#      loads it via `vars_files` and `make secrets` prompts for the vault
#      password (--ask-vault-pass).
#
# To later view/edit:  ansible-vault view app-secrets.yml  /  ansible-vault edit app-secrets.yml
# ---------------------------------------------------------------------------

# Laravel application encryption key (config/app.php -> APP_KEY).
vault_app_key: "base64:REPLACE_WITH_ROTATED_KEY"

# Password for the application's database user (app_user). Shared by the app
# (DB_PASSWORD) and the PostgreSQL chart (auth.existingSecret -> password).
vault_db_password: "REPLACE_WITH_ROTATED_PASSWORD"

# PostgreSQL superuser password (postgres-password) for the DB chart (issue #24).
vault_db_root_password: "REPLACE_WITH_ROTATED_ROOT_PASSWORD"

# Token / deploy-key for the ArgoCD GitOps repository-credential Secret
# (label argocd.argoproj.io/secret-type=repository). A read-only PAT is fine.
# The repo URL + username are non-secret role defaults (roles/secrets/defaults/main.yml:
# secrets_argocd_repo_url / secrets_argocd_repo_username) -- override them there if needed.
vault_argocd_repo_password: "REPLACE_WITH_GITOPS_REPO_TOKEN"

# Docker Hub credentials for pulling the backend image (camzerr/kubequest-back).
vault_backend_dockerhub_username: "REPLACE_WITH_DOCKERHUB_USERNAME"
vault_backend_dockerhub_password: "REPLACE_WITH_DOCKERHUB_TOKEN"

# Docker Hub credentials for pulling the frontend image.
vault_frontend_dockerhub_username: "REPLACE_WITH_DOCKERHUB_USERNAME"
vault_frontend_dockerhub_password: "REPLACE_WITH_DOCKERHUB_TOKEN"
