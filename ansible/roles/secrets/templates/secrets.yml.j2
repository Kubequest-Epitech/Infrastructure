apiVersion: v1
kind: Secret
metadata:
  name: kubequest-app
  namespace: {{ application_namespace }}
type: Opaque
stringData:
  APP_KEY: "{{ vault_app_key }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: kubequest-db
  namespace: {{ application_namespace }}
type: Opaque
stringData:
  # Key names expected by the Bitnami PostgreSQL chart's auth.existingSecret (issue #24).
  # `password` shares vault_db_password with the app's DB_PASSWORD -> single source of truth.
  postgres-password: "{{ vault_db_root_password }}"
  password: "{{ vault_db_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: {{ application_namespace }}
type: Opaque
stringData:
  DATABASE_URL: "postgresql://postgres:{{ vault_db_root_password }}@postgresql.application.svc.cluster.local:5432/postgres"
---
apiVersion: v1
kind: Secret
metadata:
  name: kubequest-gitops-repo
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  # url OBLIGATOIRE : ArgoCD associe ce credential a l'Application via cette url
  # (doit etre identique au repoURL de l'Application). Sans url => "authentication
  # required: Repository not found".
  url: "{{ argocd_repo_url }}"
  username: "{{ vault_argocd_repo_username }}"
  password: "{{ vault_argocd_repo_password }}"
---
# imagePullSecret backend (Docker Hub). data + b64encode => valeur sans
# caractere special (robuste vis-a-vis du YAML).
apiVersion: v1
kind: Secret
metadata:
  name: kubequest-dockerhub-backend
  namespace: {{ application_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "{{ {'auths': {'https://index.docker.io/v1/': {'username': vault_backend_dockerhub_username, 'password': vault_backend_dockerhub_password, 'auth': (vault_backend_dockerhub_username ~ ':' ~ vault_backend_dockerhub_password) | b64encode}}} | to_json | b64encode }}"
---
# imagePullSecret frontend (Docker Hub).
apiVersion: v1
kind: Secret
metadata:
  name: kubequest-dockerhub-frontend
  namespace: {{ application_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "{{ {'auths': {'https://index.docker.io/v1/': {'username': vault_frontend_dockerhub_username, 'password': vault_frontend_dockerhub_password, 'auth': (vault_frontend_dockerhub_username ~ ':' ~ vault_frontend_dockerhub_password) | b64encode}}} | to_json | b64encode }}"
